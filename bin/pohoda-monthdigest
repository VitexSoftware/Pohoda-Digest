#!/usr/bin/env php
<?php

declare(strict_types=1);

namespace VitexSoftware\PohodaDigest;

\define('EASE_APPNAME', 'Pohoda 🌜 Monthly Digest');

require_once __DIR__ . '/init.php';

$start = new \DateTime('-1 month');
$end = new \DateTime();
$period = new \DatePeriod($start, new \DateInterval('P1D'), $end);

$subject = sprintf(_('Pohoda 🌜 Monthly digest'));

$digestor = new PohodaDigestor($subject);
$digestor->registerModules('monthly');
$digestor->run($period);

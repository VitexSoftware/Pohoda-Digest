#!/usr/bin/env php
<?php

declare(strict_types=1);

namespace VitexSoftware\PohodaDigest;

\define('EASE_APPNAME', 'Pohoda 🎆 Yearly Digest');

require_once __DIR__ . '/init.php';

$start = new \DateTime('-1 year');
$end = new \DateTime();
$period = new \DatePeriod($start, new \DateInterval('P1D'), $end);

$subject = sprintf(_('Pohoda 🎆 Yearly digest'));

$digestor = new PohodaDigestor($subject);
$digestor->registerModules('yearly');
$digestor->run($period);

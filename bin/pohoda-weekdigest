#!/usr/bin/env php
<?php

declare(strict_types=1);

namespace VitexSoftware\PohodaDigest;

\define('EASE_APPNAME', 'Pohoda 📆 Weekly Digest');

require_once __DIR__ . '/init.php';

$start = new \DateTime('-1 week');
$end = new \DateTime();
$period = new \DatePeriod($start, new \DateInterval('P1D'), $end);

$subject = sprintf(_('Pohoda 📆 Weekly digest'));

$digestor = new PohodaDigestor($subject);
$digestor->registerModules('weekly');
$digestor->run($period);

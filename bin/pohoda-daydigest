#!/usr/bin/env php
<?php

declare(strict_types=1);

namespace VitexSoftware\PohodaDigest;

\define('EASE_APPNAME', 'Pohoda 🌅 Daily Digest');

require_once __DIR__ . '/init.php';

$start = new \DateTime('today');
$end = new \DateTime('tomorrow');
$period = new \DatePeriod($start, new \DateInterval('P1D'), $end);

$subject = sprintf(_('Pohoda 🌅 Daily digest %s'), date('Y-m-d'));

$digestor = new PohodaDigestor($subject);
$digestor->registerModules('daily');
$digestor->run($period);

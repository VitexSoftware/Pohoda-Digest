#!/usr/bin/env php
<?php

declare(strict_types=1);

namespace VitexSoftware\PohodaDigest;

\define('EASE_APPNAME', 'Pohoda 🌌 All Time Digest');

require_once __DIR__ . '/init.php';

$start = new \DateTime('-10 years');
$end = new \DateTime();
$period = new \DatePeriod($start, new \DateInterval('P1D'), $end);

$subject = sprintf(_('Pohoda 🌌 Alltime digest'));

$digestor = new PohodaDigestor($subject);
$digestor->registerModules('alltime');
$digestor->run($period);

{
  "$schema": "https://raw.githubusercontent.com/VitexSoftware/php-vitexsoftware-multiflexi-core/refs/heads/main/multiflexi.app.schema.json",
  "schemaVersion": "3.4.0",
  "uuid": "f6273939-7a91-463e-bf0f-b8e56d87ed7f",
  "name": {
    "en": "Pohoda Monthly Digest",
    "cs": "Pohoda Měsíční Digest"
  },
  "description": {
    "en": "Monthly analytics digest for Pohoda accounting system",
    "cs": "Měsíční analytický digest pro účetní systém Pohoda"
  },
  "version": "1.0.0",
  "tags": [
    "Pohoda",
    "Digest",
    "Analytics",
    "Monthly",
    "Accounting"
  ],
  "requirements": [
    "MServer"
  ],
  "homepage": "https://multiflexi.eu/doc/",
  "repository": "https://github.com/VitexSoftware/Pohoda-Digest",
  "image": "",
  "executable": "/usr/bin/pohoda-monthdigest",
  "events": {
    "emits": {
      "digest.generated": {
        "description": "A periodic digest report was generated"
      }
    }
  },
  "environment": {
    "POHODA_URL": {
      "type": "url",
      "description": {
        "en": "Pohoda mServer URL",
        "cs": "URL adresa Pohoda mServer"
      },
      "defval": "https://localhost:8080",
      "required": true,
      "category": "API"
    },
    "POHODA_ICO": {
      "type": "string",
      "description": {
        "en": "Company Identification Number (IČO)",
        "cs": "Identifikační číslo organizace (IČO)"
      },
      "defval": "12345678",
      "required": true,
      "category": "API"
    },
    "POHODA_USERNAME": {
      "type": "string",
      "description": {
        "en": "Pohoda API Username",
        "cs": "Přihlašovací jméno do Pohoda API"
      },
      "defval": "api",
      "required": true,
      "category": "API"
    },
    "POHODA_PASSWORD": {
      "type": "password",
      "description": {
        "en": "Pohoda API Password",
        "cs": "Heslo do Pohoda API"
      },
      "defval": "",
      "required": true,
      "category": "API"
    },
    "THEME": {
      "type": "set",
      "description": {
        "en": "Report Theme",
        "cs": "Téma reportu"
      },
      "defval": "bootstrap",
      "required": false,
      "category": "Other",
      "options": {
        "bootstrap": "Bootstrap",
        "email": "Email",
        "green": "Green",
        "rainbow": "Rainbow",
        "nordic-blue": "Nordic Blue",
        "violet-garden": "Violet Garden"
      }
    },
    "DIGEST_MAILTO": {
      "type": "email",
      "description": {
        "en": "Send Digest to Email Address",
        "cs": "Poslat digest na emailovou adresu"
      },
      "defval": "",
      "required": false,
      "category": "Other"
    },
    "MAIL_DSN": {
      "type": "password",
      "description": {
        "en": "Symfony Mailer DSN for sending the digest (e.g. smtp://user:pass@host:port). Defaults to local sendmail if empty. Only use insecure options like verify_peer=0 for trusted internal/private relays; prefer peer_fingerprint to pin a self-signed cert instead of disabling TLS verification.",
        "cs": "DSN pro Symfony Mailer k odeslání digestu (např. smtp://user:pass@host:port). Pokud je prázdné, použije se lokální sendmail. Nezabezpečené volby jako verify_peer=0 používejte pouze pro důvěryhodné interní/privátní relaye; pro self-signed certifikát preferujte peer_fingerprint místo vypnutí ověřování TLS."
      },
      "defval": "",
      "required": false,
      "category": "Other"
    },
    "RESULT_FILE": {
      "type": "file-path",
      "description": {
        "en": "Save Output to File",
        "cs": "Uložit výstup do souboru"
      },
      "defval": "monthly_digest.html",
      "required": false,
      "category": "Other"
    },
    "OUTPUT_FORMAT": {
      "type": "string",
      "description": {
        "en": "Output Format (html/json)",
        "cs": "Formát výstupu (html/json)"
      },
      "defval": "html",
      "required": false,
      "category": "Other"
    },
    "MODULES": {
      "type": "string",
      "description": {
        "en": "Comma-separated list of modules",
        "cs": "Seznam modulů oddělený čárkami"
      },
      "defval": "outcoming_invoices,debtors",
      "required": false,
      "category": "Behavior"
    },
    "DIGEST_ITEMS_LIMIT": {
      "type": "integer",
      "description": {
        "en": "Default maximum number of items listed in each section (0 = unlimited)",
        "cs": "Výchozí maximální počet vypsaných položek v každé sekci (0 = bez omezení)"
      },
      "defval": "0",
      "required": false,
      "category": "Behavior"
    },
    "DIGEST_LOCALE": {
      "type": "set",
      "description": {
        "en": "Language of the digest (system locale, must be installed on the server)",
        "cs": "Jazyk digestu (systémová lokalizace, musí být nainstalována na serveru)"
      },
      "defval": "cs_CZ.UTF-8",
      "required": false,
      "category": "Other",
      "options": {
        "cs_CZ.UTF-8": "Čeština",
        "en_US.UTF-8": "English"
      }
    }
  },
  "artifacts": [
    {
      "name": "Monthly Digest Report",
      "path": "${RESULT_FILE}",
      "type": "html",
      "description": {
        "en": "The monthly digest report generated by the application.",
        "cs": "Měsíční digest report generovaný aplikací."
      }
    }
  ]
}
